{
  "name": "keychain-maker",
  "private": true,
  "version": "1.0.0",
  "description": "3D print studio — keychains, pet tags, name plates, clickers, and letter stands",
  "author": "Mike Corpuz",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "preview": "vite preview",
    "desktop": "npm run build:desktop && electron .",
    "desktop:win": "npm run build:desktop && electron-builder --win portable --config.win.signAndEditExecutable=false --config.npmRebuild=false",
    "desktop:win:signed": "node scripts/sign-windows.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "clipper-lib": "^6.4.2",
    "jszip": "^3.10.1",
    "manifold-3d": "^3.5.3",
    "opentype.js": "^1.3.4",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.mikecorpuz.keychainmaker",
    "productName": "Parametric",
    "copyright": "Copyright © Mike Corpuz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KeychainMaker-${version}-Windows.${ext}"
    },
    "portable": {
      "artifactName": "KeychainMaker-${version}-Windows.exe"
    }
  }
}

# Copy to .env.signing.local (never commit) and fill in after Azure Trusted Signing is set up.
# Then run:  npm run desktop:win:signed

# Azure AD app registration used to sign
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Trusted Signing / Artifact Signing account (resource name in Azure)
AZURE_TRUSTED_SIGNING_ACCOUNT=
# Certificate profile name inside that account
AZURE_TRUSTED_SIGNING_PROFILE=
# Regional endpoint, e.g. https://eus.codesigning.azure.net/
AZURE_TRUSTED_SIGNING_ENDPOINT=
# Exact publisher CN from identity validation, e.g. Michael Corpuz
AZURE_TRUSTED_SIGNING_PUBLISHER=

# --- OR classic .pfx (USB/HSM export or older OV) ---
# CSC_LINK=C:\path\to\codesign.pfx
# CSC_KEY_PASSWORD=
